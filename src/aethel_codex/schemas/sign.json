{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethel.dev/schemas/sign-v1.json",
  "title": "AethelSignResult",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "bundle_path",
    "manifest_id",
    "role",
    "alg",
    "key_id",
    "signature_file"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "aethel.sign/1"
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "profile", "yellow_paper"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "profile": {"type": "string"},
        "yellow_paper": {"type": "string"}
      }
    },
    "bundle_path": {
      "type": "string"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^pip1:m:[0-9a-f]{64}$"
    },
    "role": {
      "type": "string"
    },
    "alg": {
      "type": "string"
    },
    "key_id": {
      "type": "string",
      "pattern": "^pip1:k:[0-9a-f]{64}$"
    },
    "signature_file": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
